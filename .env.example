# Copy to .env and fill in from your Supabase project
# (Project Settings > API). The anon key is safe to ship in the client;
# row security is enforced by RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Absolute URL of the hosted privacy policy. Only needed for Android
# builds; the web build links to its own /privacy.html.
VITE_PRIVACY_URL=https://payweek.app/privacy.html
